    private static class ParkingSlot
            implements Serializable {

        private static final long serialVersionUID = 1L;

        String number;
        boolean occupied;

        ParkingSlot(String number) {
            this.number = number;
            this.occupied = false;
        }
    }

    private static class ParkingRecord
            implements Serializable {

        private static final long serialVersionUID = 1L;

        int id;
        String plateNumber;
        String vehicleType;
        String slotNumber;
        LocalDateTime entryTime;
        LocalDateTime exitTime;

        int durationMinutes;
        double amount;

        String paymentStatus;
        String barrierStatus;

        ParkingRecord(
                int id,
                String plateNumber,
                String vehicleType,
                String slotNumber,
                LocalDateTime entryTime) {

            this.id = id;
            this.plateNumber = plateNumber;
            this.vehicleType = vehicleType;
            this.slotNumber = slotNumber;
            this.entryTime = entryTime;

            this.durationMinutes = 0;
            this.amount = 0;

            this.paymentStatus = "UNPAID";
            this.barrierStatus = "CLOSED";
        }
    }

    private static class ParkingDatabase
            implements Serializable {

        private static final long serialVersionUID = 1L;

        List<ParkingSlot> slots;
        List<ParkingRecord> records;
        int nextRecordId;

        ParkingDatabase(
                List<ParkingSlot> slots,
                List<ParkingRecord> records,
                int nextRecordId) {

            this.slots = new ArrayList<>(slots);
            this.records = new ArrayList<>(records);
            this.nextRecordId = nextRecordId;
        }
    }
