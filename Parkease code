
import com.sun.net.httpserver.Headers;
import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpServer;

import java.io.*;
import java.net.InetSocketAddress;
import java.net.URLDecoder;
import java.nio.charset.StandardCharsets;
import java.time.Duration;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.concurrent.Executors;

/**
 * ParkSmart Kenya
 * Automated Web-Based Parking Management System
 *
 * MMU Actual System Development - Java
 *
 * Features:
 * 1. Displays available and occupied parking slots.
 * 2. Records vehicle arrival.
 * 3. Records entry time automatically.
 * 4. Calculates parking duration on exit.
 * 5. Calculates parking fee according to the assignment.
 * 6. Simulates payment and barrier opening.
 * 7. Stores records locally in parking_data.dat.
 * 8. Provides simple JSON APIs for slots and fee calculation.
 *
 * Requires Java 11 or later.
 *
 * Compile:
 *     javac ParkSmartKenya.java
 *
 * Run:
 *     java ParkSmartKenya
 *
 * Open:
 *     http://localhost:8080
 */
public class ParkSmartKenya {

    private static final int PORT = 8080;
    private static final String DATA_FILE = "parking_data.dat";
    private static final DateTimeFormatter DATE_TIME =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");

    private static final List<ParkingSlot> slots = new ArrayList<>();
    private static final List<ParkingRecord> records = new ArrayList<>();

    private static int nextRecordId = 1;

    public static void main(String[] args) throws Exception {
        loadData();
        initializeSlots();

        HttpServer server = HttpServer.create(
                new InetSocketAddress(PORT), 0
        );

        server.createContext("/", ParkSmartKenya::handleHome);
        server.createContext("/entry", ParkSmartKenya::handleEntry);
        server.createContext("/exit", ParkSmartKenya::handleExit);
        server.createContext("/api/slots", ParkSmartKenya::handleSlotsApi);
        server.createContext("/api/fee", ParkSmartKenya::handleFeeApi);

        server.setExecutor(Executors.newCachedThreadPool());
        server.start();

        System.out.println("==============================================");
        System.out.println("      ParkSmart Kenya is running");
        System.out.println("==============================================");
        System.out.println("Open: http://localhost:" + PORT);
        System.out.println("Press Ctrl+C to stop.");
    }

    // ------------------------------------------------------------
    // DATABASE / LOCAL STORAGE
    // ------------------------------------------------------------

    private static synchronized void initializeSlots() {
        if (!slots.isEmpty()) {
            return;
        }

        for (int i = 1; i <= 30; i++) {
            slots.add(new ParkingSlot("P-" + String.format("%02d", i)));
        }
    }

    private static synchronized void loadData() {
        File file = new File(DATA_FILE);

        if (!file.exists()) {
            return;
        }

        try (ObjectInputStream input =
                     new ObjectInputStream(new FileInputStream(file))) {

            Object object = input.readObject();

            if (object instanceof ParkingDatabase) {
                ParkingDatabase db = (ParkingDatabase) object;

                slots.clear();
                slots.addAll(db.slots);

                records.clear();
                records.addAll(db.records);

                nextRecordId = db.nextRecordId;
            }

        } catch (Exception e) {
            System.err.println("Could not load saved data. Starting fresh.");
            System.err.println(e.getMessage());
        }
    }

    private static synchronized void saveData() {
        ParkingDatabase db =
                new ParkingDatabase(slots, records, nextRecordId);

        try (ObjectOutputStream output =
                     new ObjectOutputStream(new FileOutputStream(DATA_FILE))) {

            output.writeObject(db);

        } catch (IOException e) {
            System.err.println("Could not save parking data: " + e.getMessage());
        }
    }

