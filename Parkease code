    // ------------------------------------------------------------
    // VEHICLE ENTRY
    // ------------------------------------------------------------

    private static void handleEntry(HttpExchange exchange)
            throws IOException {

        if (!exchange.getRequestMethod().equalsIgnoreCase("POST")) {
            redirect(exchange, "/");
            return;
        }

        Map<String, String> form =
                parseFormData(exchange);

        String plate = clean(form.get("plate"));
        String vehicleType = clean(form.get("vehicleType"));
        String slotNumber = clean(form.get("slot"));

        if (plate.isEmpty() || slotNumber.isEmpty()) {
            redirect(exchange, "/");
            return;
        }

        synchronized (records) {

            // Check whether vehicle is already inside.
            for (ParkingRecord r : records) {
                if (r.exitTime == null &&
                        r.plateNumber.equalsIgnoreCase(plate)) {

                    redirect(exchange, "/");
                    return;
                }
            }

            ParkingSlot selected = findSlot(slotNumber);

            if (selected == null || selected.occupied) {
                redirect(exchange, "/");
                return;
            }

            selected.occupied = true;

            ParkingRecord record = new ParkingRecord(
                    nextRecordId++,
                    plate,
                    vehicleType,
                    selected.number,
                    LocalDateTime.now()
            );

            records.add(record);
        }

        saveData();
        redirect(exchange, "/");
    }

    // ------------------------------------------------------------
    // VEHICLE EXIT
    // ------------------------------------------------------------

    private static void handleExit(HttpExchange exchange)
            throws IOException {

        if (!exchange.getRequestMethod().equalsIgnoreCase("POST")) {
            redirect(exchange, "/");
            return;
        }

        Map<String, String> form =
                parseFormData(exchange);

        String idString = form.get("id");

        if (idString == null) {
            redirect(exchange, "/");
            return;
        }

        try {
            int id = Integer.parseInt(idString);

            synchronized (records) {
                for (ParkingRecord record : records) {

                    if (record.id == id &&
                            record.exitTime == null) {

                        LocalDateTime exit = LocalDateTime.now();

                        long minutes = Duration.between(
                                record.entryTime,
                                exit
                        ).toMinutes();

                        record.exitTime = exit;
                        record.durationMinutes = (int) Math.max(
                                0, minutes
                        );

                        record.amount =
                                calculateFee(record.durationMinutes);

                        // Simulated payment
                        record.paymentStatus = "PAID";

                        // Simulated barrier
                        record.barrierStatus = "OPEN";

                        ParkingSlot slot =
                                findSlot(record.slotNumber);

                        if (slot != null) {
                            slot.occupied = false;
                        }

                        break;
                    }
                }
            }

            saveData();

        } catch (NumberFormatException ignored) {
        }

        redirect(exchange, "/");
    }

    // ------------------------------------------------------------
    // FEE ALGORITHM
    // ------------------------------------------------------------

    /**
     * Parking fee algorithm from the assignment:
     *
     * Up to 30 minutes = Free
     * Up to 2 hours = KSh 50
     * Up to 4 hours = KSh 100
     * Up to 6 hours = KSh 300
     * Over 6 hours = KSh 500
     */
    private static double calculateFee(int minutes) {

        if (minutes <= 30) {
            return 0;
        }

        if (minutes <= 120) {
            return 50;
        }

        if (minutes <= 240) {
            return 100;
        }

        if (minutes <= 360) {
            return 300;
        }

        return 500;
    }

    // ------------------------------------------------------------
    // SLOT API
    // ------------------------------------------------------------

    private static void handleSlotsApi(HttpExchange exchange)
            throws IOException {

        if (!exchange.getRequestMethod().equalsIgnoreCase("GET")) {
            sendResponse(
                    exchange,
                    405,
                    "{\"error\":\"Method not allowed\"}",
                    "application/json"
            );
            return;
        }

        StringBuilder json = new StringBuilder("[");
        boolean first = true;

        for (ParkingSlot slot : slots) {

            if (!first) {
                json.append(",");
            }

            first = false;

            json.append("{")
                    .append("\"slot\":\"")
                    .append(jsonEscape(slot.number))
                    .append("\",")
                    .append("\"status\":\"")
                    .append(slot.occupied
                            ? "OCCUPIED"
                            : "AVAILABLE")
                    .append("\"")
                    .append("}");
        }

        json.append("]");

        sendResponse(
                exchange,
                200,
                json.toString(),
                "application/json"
        );
    }

    // ------------------------------------------------------------
    // FEE API
    // ------------------------------------------------------------

    private static void handleFeeApi(HttpExchange exchange)
            throws IOException {

        String query = exchange.getRequestURI()
                .getRawQuery();

        Map<String, String> params =
                parseQuery(query);

        try {

            int minutes = Integer.parseInt(
                    params.getOrDefault("minutes", "0")
            );

            double fee = calculateFee(minutes);

            String json = """
                    {
                      "minutes": %d,
                      "amount": %.0f
                    }
                    """.formatted(minutes, fee);

            sendResponse(
                    exchange,
                    200,
                    json,
                    "application/json"
            );

        } catch (NumberFormatException e) {

            sendResponse(
                    exchange,
                    400,
                    "{\"error\":\"minutes must be a number\"}",
                    "application/json"
            );
        }
    }

    // ------------------------------------------------------------
    // UTILITIES
    // ------------------------------------------------------------

    private static ParkingSlot findSlot(String number) {
        for (ParkingSlot slot : slots) {
            if (slot.number.equalsIgnoreCase(number)) {
                return slot;
            }
        }

        return null;
    }

    private static Map<String, String> parseFormData(
            HttpExchange exchange) throws IOException {

        InputStream input = exchange.getRequestBody();

        String body = new String(
                input.readAllBytes(),
                StandardCharsets.UTF_8
        );

        return parseQuery(body);
    }

    private static Map<String, String> parseQuery(String query) {

        Map<String, String> result =
                new HashMap<>();

        if (query == null || query.isEmpty()) {
            return result;
        }

        String[] pairs = query.split("&");

        for (String pair : pairs) {

            String[] parts = pair.split("=", 2);

            String key = urlDecode(parts[0]);

            String value = parts.length > 1
                    ? urlDecode(parts[1])
                    : "";

            result.put(key, value);
        }

        return result;
    }

    private static String urlDecode(String value) {
        try {
            return URLDecoder.decode(
                    value,
                    StandardCharsets.UTF_8
            );
        } catch (Exception e) {
            return value;
        }
    }

    private static String clean(String value) {
        if (value == null) {
            return "";
        }

        return value.trim().toUpperCase();
    }

    private static String escapeHtml(String value) {

        if (value == null) {
            return "";
        }

        return value
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;")
                .replace("'", "&#39;");
    }

    private static String jsonEscape(String value) {

        if (value == null) {
            return "";
        }

        return value
                .replace("\\", "\\\\")
                .replace("\"", "\\\"");
    }

    private static void redirect(
            HttpExchange exchange,
            String location) throws IOException {

        Headers headers = exchange.getResponseHeaders();

        headers.add("Location", location);

        exchange.sendResponseHeaders(303, -1);

        exchange.close();
    }

    private static void sendResponse(
            HttpExchange exchange,
            int status,
            String body,
            String contentType) throws IOException {

        byte[] bytes =
                body.getBytes(StandardCharsets.UTF_8);

        Headers headers =
                exchange.getResponseHeaders();

        headers.set(
                "Content-Type",
                contentType + "; charset=UTF-8"
        );

        exchange.sendResponseHeaders(
                status,
                bytes.length
        );

        try (OutputStream output =
                     exchange.getResponseBody()) {

            output.write(bytes);
        }
    }

    // ------------------------------------------------------------
    // DATA CLASSES
